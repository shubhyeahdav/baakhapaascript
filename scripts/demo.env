# Environment for `website (demo)` in .claude/launch.json.
#
# Starts the site against the local SQLite copy with every paid provider off.
# The plain `website` entry reads baakhapaa-backend/.env, which on this machine
# holds live Supabase, Anthropic and OpenAI keys — so a click there writes to
# production Postgres and a Generate press is billed.
#
# BAAKHAPAA_DEMO=1 already swaps the database (see scripts/start-site.mjs). It
# does not touch the AI keys, so they are blanked here too. python-dotenv does
# not override a variable that is already set, even to an empty string, so
# these win over the values in the backend's .env.
#
# Login: test@example.com / password
BAAKHAPAA_DEMO=1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER=
LLM_API_KEY=
STRIPE_SECRET_KEY=
PAYMENT_SANDBOX=false
