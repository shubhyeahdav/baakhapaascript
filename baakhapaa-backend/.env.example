# Baakhapaa backend configuration.
#
# Copy to `.env` and fill in. Every value here has a safe default EXCEPT
# JWT_SECRET, which the server refuses to boot without.
#
# With no keys at all the app runs in demo mode: local SQLite, canned AI
# responses, placeholder storyboard frames, simulated Stripe. Nothing is
# transmitted anywhere. That is the right setup for local development.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Signs every session token. No fallback — a guessable secret lets anyone forge
# a token for any account. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------

# Leave both blank for demo mode (SQLite at baakhapaa_local.db).
SUPABASE_URL=
SUPABASE_KEY=

# Overrides the demo database path. The test suite sets this to a throwaway file
# so it never touches your working data.
# LOCAL_DB_PATH=

# Creates the documented test@example.com / password account on a fresh database.
# Never set this in production — it is a known credential.
DEMO_SEED=false

# ---------------------------------------------------------------------------
# AI providers — these decide who receives your users' unpublished scripts
# ---------------------------------------------------------------------------

# Text generation. Set ANTHROPIC_API_KEY and the product uses Claude.
ANTHROPIC_API_KEY=

# Routing script text to anyone other than Anthropic must be deliberate, so a
# fumbled key can never silently reroute drafts to a different company.
# Leave blank to auto-select Claude (if keyed) or demo mode.
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Storyboard images (DALL-E 3). Blank = placeholder frames, nothing transmitted.
OPENAI_API_KEY=

# `placeholder` (default, offline) or `pollinations` (free, keyless, and sends
# the scene description to a third party — an opt-in you owe users a disclosure
# about).
STORYBOARD_PROVIDER=placeholder

# Frames are drawn from the writer's own action lines. Set false to draw from
# the structure beat instead: more generic boards, but nothing the writer typed
# is sent for image generation. See DATA_HANDLING.md.
STORYBOARD_USES_DRAFT_TEXT=true

# Spend ceiling. Every frame is a billed image, so this is the number you
# multiply by your image price for the worst case of one click. See the cost
# model in DEPLOYMENT.md.
MAX_STORYBOARD_FRAMES=24

# The image model. DALL-E was shut down in the API on 2026-05-12, so the old
# `dall-e-3` call would fail outright against a live key. The gpt-image family
# replaced it and takes 1024x1024, 1024x1536 or 1536x1024 only.
#
# The default is the cheap one on purpose: a storyboard frame is a thinking
# tool, not final art, and one click can bill MAX_STORYBOARD_FRAMES of them.
# gpt-image-1 at high quality is roughly 15x the cost per frame.
STORYBOARD_IMAGE_MODEL=gpt-image-1-mini
STORYBOARD_IMAGE_SIZE=1536x1024
STORYBOARD_IMAGE_QUALITY=low

# ---------------------------------------------------------------------------
# Production — set these before deploying
# ---------------------------------------------------------------------------

# The master switch. `production` turns the settings below from documentation
# into boot requirements: deploy_checks.py refuses to start if CORS_ORIGINS is
# unset, DEMO_SEED is true, the database is SQLite, or no redistributable
# Devanagari font resolves. Leave it unset for local development.
# APP_ENV=production

# Comma-separated allowlist. Unset falls back to a dev regex allowing ANY
# localhost port, which in production lets any page on a victim's machine call
# the API with their credentials. Required when APP_ENV=production.
# CORS_ORIGINS=https://baakhapaa.com,https://www.baakhapaa.com

# Where payment providers redirect back to when a request carries no Origin
# header. The fallback is localhost:3000.
# FRONTEND_URL=https://baakhapaa.com

# Fails the build if the redistributable Devanagari font is missing. Set true in
# CI and at deploy: without the bundled font, Nepali renders as blank boxes on
# any Linux host. Implied by APP_ENV=production.
REQUIRE_SHIPPABLE_FONT=false

# NOTE: run uvicorn with --proxy-headers in production. slowapi keys rate limits
# on the connecting IP, which behind a proxy is the proxy — so every user in the
# world would share one bucket, and the first person to mistype a password
# would lock out the rest. The Procfile and railway.json here already do it.

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------

# Three gateways, chosen per checkout. Any provider with no key runs in demo
# mode: the flow works end to end and no money moves. See payments.py.
#
# IMPORTANT: only Stripe has subscriptions. Khalti and eSewa take one payment
# once, so a plan bought through them carries `users.subscription_expires_at`
# and lapses to free when it passes. Nothing renews on its own.

# Each provider runs in one of three modes, and the middle one is the point:
#   live    - real credentials, production host, real money
#   sandbox - the gateway's own test host. Real HTTP, real redirect, real
#             signature checking, no money. Where an integration is proven
#   demo    - no credentials. Loops back to our own return URL and contacts
#             nobody. Correct for CI and offline work; proves nothing
#
# With no keys at all, BOTH Nepali gateways run in SANDBOX and really open their
# payment pages: eSewa uses its published UAT pair (EPAYTEST), Khalti uses the
# sandbox key printed in its own documentation samples. Stripe is the exception
# - its test keys are per-account credentials, so it simulates until you paste
# one. Set this false to force the offline simulation everywhere; the test suite
# does, because a unit test must not depend on a third party being up.
PAYMENT_SANDBOX=true

# Khalti e-Payment v2. Optional for sandbox work - without it, the key from
# Khalti's public documentation samples is used against dev.khalti.com. That is
# a documentation sample rather than a designated shared credential, so it may
# be rotated without notice and any test payment lands in whoever owns it: get
# your own from test-admin.khalti.com before relying on it. Live key from
# admin.khalti.com. With a key set, KHALTI_ENV decides the host and defaults to
# the sandbox, so a half-finished setup cannot take real money.
# Sandbox payer: Khalti ID 9800000000-5, MPIN 1111, OTP 987654.
KHALTI_SECRET_KEY=
# KHALTI_ENV=live

# eSewa ePay v2. Only needed for a real merchant account; without these the
# published UAT pair is used against rc-epay.esewa.com.np. Sandbox payer login:
# 9806800001-5 / Nepal@123, token 123456.
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
# ESEWA_ENV=live

# Stripe. Blank = demo. An `sk_test_` key is a real sandbox; only `sk_live_`
# moves money. Cards only, and it declines most Nepali cards, so
# it is the right path for an international card and the wrong default for Nepal.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Days of access one payment buys. A pricing decision, not a technical one.
SUBSCRIPTION_DAYS=30

# ---------------------------------------------------------------------------
# Email — renewal reminders only
#
# `PlanNotice` warns inside the app, but the writer who most needs telling is
# the one who has not opened it in three weeks. `renewals.py` is the cron job
# that reaches them.
#
# Plain SMTP, so any transactional provider works without a code change. With
# no SMTP_HOST the job runs, reports what it WOULD have sent, and sends
# nothing — it never pretends to have delivered mail.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Baakhapaa

# How many days before expiry the first reminder goes out.
RENEWAL_WARN_DAYS=7

# ---------------------------------------------------------------------------
# Tuning — defaults are sensible; change only with a reason
# ---------------------------------------------------------------------------

# One auto-save version snapshot per this many seconds. Lower it and version
# history fills with near-identical entries; raise it and you lose granularity.
AUTOSAVE_SNAPSHOT_WINDOW_SECONDS=300

# Credential endpoints, per IP.
LOGIN_RATE_LIMIT=5/minute
REGISTER_RATE_LIMIT=5/minute
# Disabled by the test suite only — limits are per-process and would leak
# between tests.
RATE_LIMITS_ENABLED=true

# Embedding storyboard frames in the production package means fetching them.
# Bounded per fetch and across the set; failures degrade to a captioned box.
EMBED_STORYBOARD_IMAGES=true
STORYBOARD_IMAGE_TIMEOUT=5
STORYBOARD_IMAGE_BUDGET=20

# Corpus percentiles for the benchmark layer.
# CORPUS_FINGERPRINTS=corpus_fingerprints.json
