# Dependencies
node_modules/

# Production builds
build/
dist/

# Python
__pycache__/
*.pyc
venv/
.venv/

# OS / editor
.DS_Store
Thumbs.db

# Secrets
.env
baakhapaa-backend/baakhapaa_local.db

# Downloaded installers — ~300 MB of tooling that landed in the repo root.
# Nothing here belongs in version control.
*.exe

# THE SCRIPT CORPUS — copyrighted screenplays. Never commit, never push,
# never publish. See CLAUDE.md "Copyright". The archive and any extraction of
# it are covered here because the repo root is not a safe place to keep it and
# a single `git add -A` would otherwise stage 1.8 GB of other people's work.
*.zip
Script Library/
raw_scripts_TEMP/
extracted_scripts/

# Corpus fingerprints are generated, and the corpus itself must never be
# committed (see CLAUDE.md "Copyright"). The fingerprint FILE is safe to
# commit if you choose to — it holds measurements only, no script text —
# so this is a convenience default, not a safety rule.
corpus_fingerprints.json
baakhapaa-backend/corpus_fingerprints.json

# Media and stray downloads that landed in the repo root. Same reasoning as the
# installers above: nothing here is source, and a `git add -A` would sweep them
# in. The karaoke track is somebody else's recording and must never be pushed.
*.mp3
*.mp4
*.wav
report-*.pdf
*.skill
