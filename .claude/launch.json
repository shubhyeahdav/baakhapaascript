{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "website",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/start-site.mjs"],
      "cwd": "${workspaceFolder}",
      "port": 3000
    },
    {
      "name": "website (demo)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--env-file=scripts/demo.env", "scripts/start-site.mjs"],
      "cwd": "${workspaceFolder}",
      "port": 3000
    },
    {
      "name": "website (free AI)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--env-file=scripts/free-ai.env", "scripts/start-site.mjs"],
      "cwd": "${workspaceFolder}",
      "port": 3000
    }
  ]
}
